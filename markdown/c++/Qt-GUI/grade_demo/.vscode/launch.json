{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 grade_demo",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/grade_demo.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "启用变量漂亮打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
